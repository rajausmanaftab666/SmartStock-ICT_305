# Copy this file to .env and fill in the values for your setup.

NODE_ENV=development
PORT=4000

# Any long random string. Sessions are invalidated when this changes.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-16-chars

# Origin allowed to hold a session cookie (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Password given to every seeded demo account.
SEED_PASSWORD=demo1234


# ===========================================================================
# DATABASE — pick ONE of the three blocks below
# ===========================================================================

# --- Option A: PostgreSQL in Docker (default, nothing to install) ----------
# From the smartstock folder:
#   npm run db:up        starts the container and waits until it is ready
#   npm run db:setup     applies the schema and loads the demo data
#
# The container creates the role, the password and the database itself, so
# this URL works with no further setup. Port 5433 rather than 5432 so it
# cannot collide with a native PostgreSQL service already on this machine —
# see docker-compose.yml.
DATABASE_URL=postgresql://smartstock:smartstock_dev@localhost:5433/smartstock
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=10

# --- Option B: native PostgreSQL on this machine ---------------------------
# Comment out Option A above and uncomment these two. The role and database
# have to be created first — see step 1 of the README.
#
# DATABASE_URL=postgresql://smartstock:smartstock_dev@localhost:5432/smartstock
# DATABASE_SSL=false

# --- Option C: Supabase ----------------------------------------------------
# Comment out Option A above and uncomment these three.
#
# Take the string from: Supabase dashboard -> Connect -> Session pooler.
# Use the SESSION pooler (port 5432), not the transaction pooler (6543):
# receiving stock relies on SELECT ... FOR UPDATE row locks held across a
# transaction, and session mode is the safer place for that.
#
# Replace [YOUR-PASSWORD] with the database password you set when creating
# the project, and [PROJECT-REF] / [REGION] with your own values.
#
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# DATABASE_SSL=true
# DATABASE_MAX_CONNECTIONS=5
#
# Certificates: Supabase signs with its own authority, which Node does not
# trust by default, so DATABASE_SSL=true on its own fails with
# "self-signed certificate in certificate chain". Two ways round it:
#
#   Proper fix — download the certificate from the Supabase dashboard
#   (Settings -> Database -> SSL Configuration -> Download certificate), save
#   it as server/certs/supabase-ca.crt, and set:
#
# DATABASE_CA_CERT=certs/supabase-ca.crt
#
#   Quick fix — skip verification. The connection is still encrypted, it just
#   no longer checks who is on the other end. Fine for development:
#
# DATABASE_SSL=no-verify
